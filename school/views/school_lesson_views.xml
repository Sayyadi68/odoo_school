<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="action_lesson" model="ir.actions.act_window">
            <field name="name">نام درس</field>
            <field name="res_model">school.lesson</field>
            <field name="view_mode">tree,form</field>
        </record>


        <record id="view_lesson_form" model="ir.ui.view">
            <field name="name">school.lesson.form</field>
            <field name="model">school.lesson</field>

            <field name="arch" type="xml">
                <form string="درس جدید">
                    <sheet>

                        <group>
                            <group>
                                <field
                                    name="lesson_name"
                                    placeholder="نام درس را وارد کنید"
                                />

                                <field
                                    name="lesson_unit"
                                    placeholder="تعداد واحد درس"
                                />
                            </group>

                            <group>
                                <field
                                    name="lesson_teacher"
                                    placeholder="استاد درس را انتخاب کنید"
                                />

                                <field
                                    name="lesson_student"
                                    placeholder="دانشجو را انتخاب کنید"
                                />
                            </group>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_lesson_tree" model="ir.ui.view">
            <field name="name">school.lesson.tree</field>
            <field name="model">school.lesson</field>
            <field name="arch" type="xml">
                <tree default_order="id desc">
                    <field name="lesson_name"></field>
                    <field name="lesson_unit"></field>
                    <field name="lesson_teacher" widget="many2many_tags"></field>
                    <field name="lesson_student" widget="many2many_tags"></field>
                </tree>
            </field>
        </record>


    </data>
</odoo>