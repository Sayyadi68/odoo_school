<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>


        <record id="action_student" model="ir.actions.act_window">
            <field name="name">نام دانشجو</field>
            <field name="res_model">school.student</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_student_tree" />
        </record>


        <record id="view_student_form" model="ir.ui.view">
            <field name="name">school.student.form</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <form string="دانشجوی جدید">
                    <sheet>

                        <group>
                            <field name="is_active" />
                            <field name="first_name" placeholder="نام خود را وارد کنید"></field>
                            <field name="last_name"></field>
                            <field name="description" placeholder="توضیحات تکمیلی" />
                        </group>


                        <notebook>

                            <page string="اطلاعات شخصی">
                                <group>
                                    <group>
                                        <field name="first_name" />
                                        <field name="last_name" />
                                        <field name="birth_date" placeholder="تاریخ تولد" />
                                        <field name="gender" placeholder="جنسیت" />
                                        <field name="email" placeholder="ایمیل" />
                                    </group>
                                    <group>
                                        <field name="phone" placeholder="شماره تلفن همراه" />
                                        <field name="address" placeholder="ادرس محل سکونت" />
                                    </group>
                                </group>
                            </page>
                            <page string="اطلاعات دانشجویی">
                                <group>
                                    <field name="student_code" placeholder="کد دانشجویی" />
                                    <field name="average" placeholder="معدل ترم" />
                                    <field name="grade" />

                                    <field name="lesson" widget="many2many_tags" placeholder="دروس انتخابی" />

                                </group>
                            </page>

                        </notebook>

                    </sheet>
                </form>
            </field>

        </record>


        <record id="view_student_tree" model="ir.ui.view">
            <field name="name">school.student.tree</field>
            <field name="model">school.student</field>
            <field name="arch" type="xml">
                <tree default_order="id desc">
                    <field name="first_name" />
                    <field name="last_name" />
                    <field name="grade" />
                    <field name="birth_date" optional="show" />
                    <field name="lesson" widget="many2many_tags"/>
                    <field name="phone" optional="hide" />
                    <field name="email" optional="hide" />
                    <field name="student_code" />
                    <field name="average" />
                </tree>
            </field>
        </record>


    </data>
</odoo>